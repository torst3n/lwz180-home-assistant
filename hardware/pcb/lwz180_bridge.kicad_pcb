(kicad_pcb (version 20211014) (generator pcbnew)
  (general
    (thickness 1.6)
  )
  (paper "A4")
  (layers
    (0 "F.Cu" signal)
    (31 "B.Cu" signal)
    (36 "B.SilkS" user "B.Silkscreen")
    (37 "F.SilkS" user "F.Silkscreen")
    (38 "B.Mask" user)
    (39 "F.Mask" user)
    (44 "Edge.Cuts" user)
  )
  (setup
    (pad_to_mask_clearance 0.05)
    (pcbplotparams
      (layerselection 0x00010fc_ffffffff)
      (usegerberextensions true)
      (excludeedgelayer true)
      (linewidth 0.1)
    )
  )
  (net 0 "")
  (net 1 "5V")
  (net 2 "GND")
  (net 3 "3V3")
  (net 4 "I2C_SDA")
  (net 5 "I2C_SCL")
  (net 6 "UART_TX1")
  (net 7 "UART_RX0")
  (net 8 "UART_RX2")
  (net 9 "UART_TX2")
  (net 10 "RST")

  (gr_line (start 0 0) (end 90 0) (layer "Edge.Cuts") (width 0.1))
  (gr_line (start 90 0) (end 90 60) (layer "Edge.Cuts") (width 0.1))
  (gr_line (start 90 60) (end 0 60) (layer "Edge.Cuts") (width 0.1))
  (gr_line (start 0 60) (end 0 0) (layer "Edge.Cuts") (width 0.1))

  (gr_line (start 27.62 5) (end 27.62 55) (layer "F.SilkS") (width 0.2))
  (gr_text "ISOLATION BARRIER" (at 27.62 30 90) (layer "F.SilkS") (effects (font (size 1.2 1.2) (thickness 0.2))))
  (gr_text "LWZ 180 BRIDGE" (at 60 5) (layer "F.SilkS") (effects (font (size 1.5 1.5) (thickness 0.25))))

  (footprint "MountingHole:MountingHole_3.2mm_M3_Pad" (layer "F.Cu")
    (at 4 4)
    (pad "1" thru_hole circle (at 0 0) (size 6 6) (drill 3.2) (layers *.Cu *.Mask))
  )
  (footprint "MountingHole:MountingHole_3.2mm_M3_Pad" (layer "F.Cu")
    (at 86 4)
    (pad "1" thru_hole circle (at 0 0) (size 6 6) (drill 3.2) (layers *.Cu *.Mask))
  )
  (footprint "MountingHole:MountingHole_3.2mm_M3_Pad" (layer "F.Cu")
    (at 4 56)
    (pad "1" thru_hole circle (at 0 0) (size 6 6) (drill 3.2) (layers *.Cu *.Mask))
  )
  (footprint "MountingHole:MountingHole_3.2mm_M3_Pad" (layer "F.Cu")
    (at 86 56)
    (pad "1" thru_hole circle (at 0 0) (size 6 6) (drill 3.2) (layers *.Cu *.Mask))
  )
)
